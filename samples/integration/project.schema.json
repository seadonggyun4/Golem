{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Golem D1 project",
  "type": "object",
  "properties": {
    "schema": {
      "const": "golem.integration-project.v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "identity": {
      "type": "object",
      "properties": {
        "device": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "device",
        "inode"
      ],
      "additionalProperties": false
    },
    "runtime_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "runtime_identity": {
      "type": "object",
      "properties": {
        "device": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "device",
        "inode"
      ],
      "additionalProperties": false
    },
    "cli": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "maxLength": 64
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "sdk_pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "works": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "work_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "identity": {
            "type": "object",
            "properties": {
              "device": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "inode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "device",
              "inode"
            ],
            "additionalProperties": false
          },
          "genesis_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          }
        },
        "required": [
          "work_id",
          "path",
          "identity",
          "genesis_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "project_id",
    "root",
    "identity",
    "runtime_root",
    "runtime_identity",
    "cli",
    "sdk_pins",
    "works"
  ],
  "additionalProperties": false
}
