{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Golem D1 binding",
  "type": "object",
  "properties": {
    "schema": {
      "const": "golem.integration-client-binding.v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "client_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "assurance": {
      "const": "LOCAL_COOPERATIVE"
    }
  },
  "required": [
    "schema",
    "project_id",
    "generation",
    "principal_id",
    "client_id",
    "assurance"
  ],
  "additionalProperties": false
}
